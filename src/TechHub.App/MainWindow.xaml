<ui:FluentWindow x:Class="TechHub.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TechHub — Manutenção e Suporte"
                 Width="1180"
                 Height="760"
                 MinWidth="900"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="TechHub" />
            <TextBlock Foreground="#667085" Text="Central de manutenção e suporte para Windows" />
        </StackPanel>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Padding="12">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,8,8">
                        <DockPanel Margin="0,0,0,18">
                            <Button Width="120" HorizontalAlignment="Right" Command="{Binding Dashboard.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Saúde do computador" />
                                <TextBlock Foreground="#667085" Text="Métricas locais, sem telemetria automática." />
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Margin="0,0,10,0" Padding="16" Background="#EEF4FF" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Nota de saúde" />
                                    <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding Dashboard.HealthScore}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="16" Background="#F5F3FF" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="CPU" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.CpuUsagePercent, StringFormat={}{0:0.0}%}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="16" Background="#ECFDF3" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Memória" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.MemoryUsagePercent, StringFormat={}{0:0.0}%}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="16" Background="#FFF7ED" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Disco do sistema" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.DiskUsagePercent, StringFormat={}{0:0.0}%}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <GroupBox Header="Ambiente" Margin="0,0,0,12">
                            <StackPanel Margin="12">
                                <TextBlock Text="{Binding Dashboard.OperatingSystem}" />
                                <TextBlock Text="{Binding Dashboard.PrivilegeText}" />
                                <TextBlock Text="{Binding Dashboard.FreeDiskText}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Alertas">
                            <ItemsControl Margin="12" ItemsSource="{Binding Dashboard.Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="•  {Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                        <TextBlock Margin="0,12,0,0" Foreground="#667085" Text="{Binding Dashboard.StatusMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Impressoras">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Printers.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Impressoras" />
                            <TextBlock Foreground="#667085" Text="Inventário local e instalação controlada por IP." />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Printers.Printers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="Nome" Width="2*" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="*" />
                            <DataGridTextColumn Binding="{Binding DriverName}" Header="Driver" Width="2*" />
                            <DataGridTextColumn Binding="{Binding PortName}" Header="Porta" Width="*" />
                            <DataGridCheckBoxColumn Binding="{Binding IsDefault}" Header="Padrão" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="14" Background="#F8FAFC" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,8,0" Text="{Binding Printers.IpAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="Endereço IPv4" />
                            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Printers.PrinterName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome opcional" />
                            <Button Grid.Column="2" Command="{Binding Printers.InstallByIpCommand}" Content="Instalar por IP" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Rede">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Network.ScanCommand}" Content="Varredura" DockPanel.Dock="Right" IsEnabled="{Binding Network.HasConsent}" />
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Rede local" />
                            <TextBlock Foreground="#667085" Text="Descoberta consentida de dispositivos na sub-rede ativa." />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="14" Background="#FFF7ED" CornerRadius="8">
                        <DockPanel>
                            <Button Width="160" HorizontalAlignment="Right" Command="{Binding Network.GrantConsentCommand}" Content="Registrar consentimento" DockPanel.Dock="Right" />
                            <TextBlock VerticalAlignment="Center" Text="A primeira varredura requer confirmação explícita. Nenhum host é consultado antes disso." TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Network.Devices}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP" Width="*" />
                            <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC" Width="1.3*" />
                            <DataGridTextColumn Binding="{Binding Manufacturer}" Header="Fabricante" Width="1.5*" />
                            <DataGridTextColumn Binding="{Binding DeviceType}" Header="Tipo" Width="1.5*" />
                            <DataGridTextColumn Binding="{Binding LatencyMilliseconds, StringFormat={}{0} ms}" Header="Latência" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnóstico">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Diagnostics.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Diagnóstico e reparo" />
                            <TextBlock Foreground="#667085" Text="Coleta local e reparos guiados do Windows." />
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                        <Border Margin="0,0,10,0" Padding="14" Background="#F8FAFC" CornerRadius="8">
                            <StackPanel><TextBlock Text="Sistema" /><TextBlock FontWeight="SemiBold" Text="{Binding Diagnostics.OperatingSystem}" /><TextBlock Text="{Binding Diagnostics.OsVersion}" /></StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14" Background="#F8FAFC" CornerRadius="8">
                            <StackPanel><TextBlock Text="Tempo ligado" /><TextBlock FontWeight="SemiBold" Text="{Binding Diagnostics.UptimeText}" /></StackPanel>
                        </Border>
                        <Border Padding="14" Background="#FFF7ED" CornerRadius="8">
                            <StackPanel><TextBlock Text="Reparos" /><StackPanel Orientation="Horizontal"><Button Margin="0,6,6,0" Command="{Binding Diagnostics.RepairSfcCommand}" Content="SFC" /><Button Margin="0,6,0,0" Command="{Binding Diagnostics.RepairDismCommand}" Content="DISM" /></StackPanel></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <GroupBox Margin="0,0,8,0" Header="Discos">
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Diagnostics.Disks}">
                                <DataGrid.Columns><DataGridTextColumn Binding="{Binding Model}" Header="Modelo" Width="2*" /><DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="*" /><DataGridTextColumn Binding="{Binding SizeBytes}" Header="Tamanho" Width="*" /></DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Margin="8,0,0,0" Header="Recomendações">
                            <ItemsControl Margin="12" ItemsSource="{Binding Diagnostics.Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="•  {Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </GroupBox>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#667085" Text="{Binding Diagnostics.StatusMessage}" />
                </Grid>
            </TabItem>

            <TabItem Header="Segurança">
                <ScrollViewer Margin="24,8,8,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Width="120" HorizontalAlignment="Right" Command="{Binding Security.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                            <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Segurança do Windows" /><TextBlock Foreground="#667085" Text="Estado local; o TechHub não envia telemetria." /></StackPanel>
                        </DockPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Margin="0,0,10,10" Padding="14" Background="#F8FAFC" CornerRadius="8"><StackPanel><TextBlock Text="Defender" /><TextBlock FontSize="18" Text="{Binding Security.DefenderEnabled}" /><TextBlock Text="Proteção em tempo real" /><TextBlock Text="{Binding Security.RealTimeProtectionEnabled}" /></StackPanel></Border>
                            <Border Margin="0,0,10,10" Padding="14" Background="#F8FAFC" CornerRadius="8"><StackPanel><TextBlock Text="Firewall" /><TextBlock FontSize="18" Text="{Binding Security.FirewallEnabled}" /><TextBlock Text="BitLocker" /><TextBlock Text="{Binding Security.BitLockerEnabled}" /></StackPanel></Border>
                            <Border Padding="14" Background="#F8FAFC" CornerRadius="8"><StackPanel><TextBlock Text="Dispositivo" /><TextBlock Text="TPM" /><TextBlock Text="{Binding Security.TpmPresent}" /><TextBlock Text="Secure Boot" /><TextBlock Text="{Binding Security.SecureBootEnabled}" /></StackPanel></Border>
                        </UniformGrid>
                        <Button Width="210" HorizontalAlignment="Left" Command="{Binding Security.QuickScanCommand}" Content="Solicitar varredura rápida" />
                        <GroupBox Margin="0,16,0,0" Header="Alertas">
                            <ItemsControl Margin="12" ItemsSource="{Binding Security.Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="•  {Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </GroupBox>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal"><TextBlock Foreground="#667085" Text="Administradores locais detectados: " /><TextBlock Foreground="#667085" Text="{Binding Security.LocalAdministratorCount}" /></StackPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="{Binding Security.StatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Drivers">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Drivers.RefreshCommand}" Content="Inventariar" DockPanel.Dock="Right" />
                        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Drivers e dispositivos" /><TextBlock Foreground="#667085" Text="Inventário local; instalação somente de pacote INF local assinado." /></StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Drivers.Drivers}">
                        <DataGrid.Columns><DataGridTextColumn Binding="{Binding DeviceName}" Header="Dispositivo" Width="2*" /><DataGridTextColumn Binding="{Binding Manufacturer}" Header="Fabricante" Width="1.3*" /><DataGridTextColumn Binding="{Binding Provider}" Header="Fornecedor" Width="1.3*" /><DataGridTextColumn Binding="{Binding Version}" Header="Versão" Width="*" /><DataGridCheckBoxColumn Binding="{Binding HasProblem}" Header="Problema" Width="Auto" /></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="#F8FAFC" CornerRadius="8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding Drivers.InfPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Caminho local do INF assinado" /><Button Grid.Column="1" Margin="0,0,12,0" Command="{Binding Drivers.InstallOfflineCommand}" Content="Verificar e instalar INF" /><TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding Drivers.BackupDestination, UpdateSourceTrigger=PropertyChanged}" ToolTip="Diretório vazio de backup" /><Button Grid.Column="3" Command="{Binding Drivers.BackupCommand}" Content="Backup" /></Grid>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#667085" Text="{Binding Drivers.StatusMessage}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Limpeza">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Cleaning.AnalyzeCommand}" Content="Gerar prévia" DockPanel.Dock="Right" />
                        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Limpeza controlada" /><TextBlock Foreground="#667085" Text="A análise não apaga arquivos; a execução exige confirmação e ponto de restauração." /></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Modo:" /><ComboBox Width="120" ItemsSource="{Binding Cleaning.Modes}" SelectedItem="{Binding Cleaning.Mode}" /><Button Grid.Column="2" Command="{Binding Cleaning.ExecuteCommand}" Content="Executar prévia" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><GroupBox Margin="0,0,10,0" Header="Escopos"><ItemsControl Margin="10" ItemsSource="{Binding Cleaning.Scopes}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,0,0,7" Content="{Binding Label}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox><DataGrid Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Cleaning.Items}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Location}" Header="Arquivo" Width="2*" /><DataGridTextColumn Binding="{Binding Bytes}" Header="Bytes" Width="*" /><DataGridTextColumn Binding="{Binding Reason}" Header="Motivo" Width="1.5*" /></DataGrid.Columns></DataGrid></Grid>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#667085" Text="{Binding Cleaning.StatusMessage}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Atendimento">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><Button Width="120" HorizontalAlignment="Right" Command="{Binding Tickets.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" /><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Central de Atendimento" /><TextBlock Foreground="#667085" Text="Chamados locais com histórico e diagnóstico anexável." /></StackPanel></DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding Tickets.Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="Título" /><TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Tickets.Description, UpdateSourceTrigger=PropertyChanged}" ToolTip="Descrição" /><ComboBox Grid.Column="2" Width="120" Margin="0,0,8,0" ItemsSource="{Binding Tickets.Categories}" SelectedItem="{Binding Tickets.Category}" /><ComboBox Grid.Column="3" Width="100" Margin="0,0,8,0" ItemsSource="{Binding Tickets.Priorities}" SelectedItem="{Binding Tickets.Priority}" /><Button Grid.Column="4" Command="{Binding Tickets.CreateCommand}" Content="Criar chamado" /></Grid>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Tickets.Tickets}" SelectedItem="{Binding Tickets.SelectedTicket}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Id}" Header="#" Width="Auto" /><DataGridTextColumn Binding="{Binding Title}" Header="Título" Width="2*" /><DataGridTextColumn Binding="{Binding Category}" Header="Categoria" Width="*" /><DataGridTextColumn Binding="{Binding Priority}" Header="Prioridade" Width="*" /><DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="*" /><DataGridTextColumn Binding="{Binding UpdatedAt}" Header="Atualizado" Width="1.4*" /></DataGrid.Columns></DataGrid>
                    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding Tickets.Comment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comentário do técnico" /><Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding Tickets.AddCommentCommand}" Content="Comentar" /><Button Grid.Column="2" Margin="0,0,8,0" Command="{Binding Tickets.CollectDiagnosticsCommand}" Content="Coletar diagnóstico" /><Button Grid.Column="3" Command="{Binding Tickets.SetResolvedCommand}" Content="Resolver" /><TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="{Binding Tickets.StatusMessage}" /></Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Relatórios">
                <StackPanel Margin="24,8,8,8">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Relatórios e exportação" />
                    <TextBlock Margin="0,0,0,16" Foreground="#667085" Text="Exportação local dos chamados em formatos abertos." />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Reports.CsvPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding Reports.ExportCsvCommand}" Content="Exportar CSV" /></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Reports.JsonPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding Reports.ExportJsonCommand}" Content="Exportar JSON" /></Grid>
                    <TextBlock Margin="0,16,0,0" Foreground="#667085" Text="{Binding Reports.StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Software">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Software e atualizações" /><TextBlock Foreground="#667085" Text="Inventário do registro e atualizações via winget, sempre com confirmação." /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Margin="6,0,0,0" Command="{Binding Software.RefreshCommand}" Content="Inventário" /><Button Margin="6,0,0,0" Command="{Binding Software.CheckUpgradesCommand}" Content="Verificar atualizações" /><Button Margin="6,0,0,0" Command="{Binding Software.UpgradeAllCommand}" Content="Atualizar tudo" /></StackPanel></DockPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Software.Software}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Name}" Header="Nome" Width="2*" /><DataGridTextColumn Binding="{Binding Version}" Header="Versão" Width="*" /><DataGridTextColumn Binding="{Binding Publisher}" Header="Fabricante" Width="1.5*" /><DataGridTextColumn Binding="{Binding Source}" Header="Origem" Width="1.5*" /></DataGrid.Columns></DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,12,0,4" Foreground="#667085" Text="{Binding Software.UpgradeMessage}" TextWrapping="Wrap" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Software.UpgradeLines}" />
                </Grid>
            </TabItem>

            <TabItem Header="Automação">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><Button Width="120" HorizontalAlignment="Right" Command="{Binding Automation.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" /><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Automação" /><TextBlock Foreground="#667085" Text="Playbooks locais com ações aprovadas e confirmação." /></StackPanel></DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Automation.Playbooks}" SelectedItem="{Binding Automation.SelectedPlaybook}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Foreground="#667085" Text="{Binding Description}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal"><TextBlock Text="Etapas: " /><TextBlock Text="{Binding Steps.Count}" /></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Width="140" HorizontalAlignment="Left" Command="{Binding Automation.RunCommand}" Content="Executar playbook" DockPanel.Dock="Left" /><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="{Binding Automation.StatusMessage}" TextWrapping="Wrap" /></DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Assistente">
                <ScrollViewer Margin="24,8,8,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Assistente de diagnóstico" />
                        <TextBlock Margin="0,0,0,12" Foreground="#667085" Text="Funciona offline por regras; não envia sintomas para serviços externos." TextWrapping="Wrap" />
                        <DockPanel Margin="0,0,0,16"><TextBox Text="{Binding Assistant.Symptom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex.: PC lento, sem internet, impressora não imprime" /><Button Width="100" Margin="8,0,0,0" Command="{Binding Assistant.AskCommand}" Content="Analisar" DockPanel.Dock="Right" /></DockPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Assistant.Summary}" TextWrapping="Wrap" />
                        <GroupBox Margin="0,16,0,0" Header="Perguntas"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.Questions}" /></GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="Verificações recomendadas"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.RecommendedChecks}" /></GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="Ações seguras"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.SafeActions}" /></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
