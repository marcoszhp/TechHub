<ui:FluentWindow x:Class="TechHub.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:TechHub.App.Views"
                 Title="TechHub — Manutenção e Suporte"
                 Width="1360"
                 Height="860"
                 MinWidth="1080"
                 MinHeight="700"
                 FontFamily="Segoe UI"
                 Foreground="{StaticResource HubInk}"
                 Background="{StaticResource HubBackground}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TechHub — Manutenção e Suporte" />
        <TextBlock Grid.Row="0" Text="☾ Tema escuro" IsHitTestVisible="False" HorizontalAlignment="Right" Margin="0,4,112,0" VerticalAlignment="Center" Foreground="{StaticResource HubMuted}" FontSize="12" />

        <TabControl x:Name="Navigation" Grid.Row="1" Style="{StaticResource HubNavigation}" SelectionChanged="OnNavigationChanged">
            <TabItem Header="Dashboard" Uid="dashboard" Tag="&#xE80F;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,8,8">
                        <StackPanel Margin="0,0,0,18">
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Margin="8,4,0,4" Command="{Binding Dashboard.RefreshCommand}" Content="Atualizar dados" Style="{StaticResource HubSecondaryButton}" />
                            </WrapPanel>
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Saúde do computador" />
                                <TextBlock Foreground="{StaticResource HubMuted}" Text="Métricas locais, sem telemetria automática." />
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Margin="0,0,10,0" Padding="16" Background="{StaticResource HubInfoSurface}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Índice de recursos¹" />
                                    <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding Dashboard.HealthScore, TargetNullValue=—}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="16" Background="{StaticResource HubSecondarySurface}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="CPU" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.CpuUsagePercent, StringFormat={}{0:0.0}%, TargetNullValue=—}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="16" Background="{StaticResource HubSuccessSurface}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Memória" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.MemoryUsagePercent, StringFormat={}{0:0.0}%, TargetNullValue=—}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="16" Background="{StaticResource HubWarningSurface}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Disco do sistema" />
                                    <TextBlock FontSize="24" Text="{Binding Dashboard.DiskUsagePercent, StringFormat={}{0:0.0}%, TargetNullValue=—}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <GroupBox Header="Ambiente" Margin="0,0,0,12">
                            <StackPanel Margin="12">
                                <TextBlock Text="{Binding Dashboard.OperatingSystem}" />
                                <TextBlock Text="{Binding Dashboard.PrivilegeText}" />
                                <TextBlock Text="{Binding Dashboard.FreeDiskText}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Alertas">
                            <ItemsControl Margin="12" ItemsSource="{Binding Dashboard.Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=•  {0}}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Dashboard.StatusMessage}" />
                        <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource HubSurface}" BorderBrush="{StaticResource HubBorder}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Atualização do TechHub" FontSize="18" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Versão atual: " Foreground="{StaticResource HubMuted}" />
                                    <TextBlock Text="{Binding Dashboard.CurrentVersion}" Margin="0,0,24,0" />
                                    <TextBlock Text="Versão disponível: " Foreground="{StaticResource HubMuted}" />
                                    <TextBlock Text="{Binding Dashboard.AvailableVersion}" />
                                </WrapPanel>
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource HubInfo}" Text="{Binding Dashboard.UpdateStatus}" TextWrapping="Wrap" />
                                <ProgressBar Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding Dashboard.UpdateProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding Dashboard.IsCheckingUpdate}" Background="{StaticResource HubAlternateSurface}" Foreground="{StaticResource HubInfo}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Dashboard.UpdateProgressText}" Foreground="{StaticResource HubMuted}" />
                                <Expander Header="Notas da versão" Margin="0,8,0,0">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Dashboard.ReleaseNotes}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Expander>
                                <TextBlock Margin="0,10,0,0" Text="Verificação manual. A instalação exige sua confirmação e reinicia o aplicativo. Salve seu trabalho." Foreground="{StaticResource HubMuted}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Margin="0,4,8,4" Command="{Binding Dashboard.CheckUpdatesCommand}" Content="Verificar atualização" Style="{StaticResource HubSecondaryButton}" />
                                    <Button Margin="0,4,8,4" Command="{Binding Dashboard.InstallUpdateCommand}" Content="Atualizar e reiniciar">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Margin="0,4,0,4" Command="{Binding Dashboard.CancelUpdateCommand}" Content="Cancelar" Style="{StaticResource HubSecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource HubMuted}" Text="¹ Estimativa baseada em CPU, memória e espaço em disco. Não substitui diagnóstico de hardware ou segurança." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Informações do PC" Uid="computer" Tag="&#xE7F4;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
            <TabItem Header="Mapa de rede" Uid="network" Tag="&#xE968;"><views:NetworkView DataContext="{Binding Network}" /></TabItem>
            <TabItem Header="Central técnica" Uid="tools" Tag="&#xE713;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
            <TabItem Header="Impressoras" Uid="printers" Tag="&#xE749;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Printers.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Impressoras" />
                            <TextBlock Foreground="{StaticResource HubMuted}" Text="Inventário local e instalação controlada por IP." />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Printers.Printers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="Nome" Width="2*" />
                            <DataGridTextColumn Binding="{Binding Status, Mode=OneWay}" Header="Status" Width="*" />
                            <DataGridTextColumn Binding="{Binding DriverName, Mode=OneWay}" Header="Driver" Width="2*" />
                            <DataGridTextColumn Binding="{Binding PortName, Mode=OneWay}" Header="Porta" Width="*" />
                            <DataGridCheckBoxColumn Binding="{Binding IsDefault, Mode=OneWay}" ElementStyle="{StaticResource HubReadOnlyCheckBox}" Header="Padrão" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Endereço IPv4 da impressora" /><TextBox Text="{Binding Printers.IpAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="IP da impressora" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Nome (opcional)" /><TextBox Text="{Binding Printers.PrinterName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da impressora" /></StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{Binding Printers.InstallByIpCommand}" Content="Instalar por IP" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Printers.StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnóstico" Uid="diagnostics" Tag="&#xE9D9;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Command="{Binding Diagnostics.RefreshCommand}" Content="Atualizar dados" Margin="0,4,8,4" />
                                <Button Command="{Binding Diagnostics.CancelRefreshCommand}" Content="Cancelar consulta" IsEnabled="{Binding Diagnostics.IsRefreshing, Mode=OneWay}" Style="{StaticResource HubSecondaryButton}" />
                            </WrapPanel>
                            <ProgressBar AutomationProperties.Name="Operação em andamento">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource HubBusyProgress}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Diagnostics.IsBusy, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Diagnostics.IsRefreshing, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Diagnóstico e reparo" TextWrapping="Wrap" />
                            <TextBlock Foreground="{StaticResource HubMuted}" Text="Coleta local e reparos guiados do Windows." TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                        <Border Margin="0,0,10,0" Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8">
                            <StackPanel><TextBlock Text="Sistema" /><TextBlock FontWeight="SemiBold" Text="{Binding Diagnostics.OperatingSystem}" TextWrapping="Wrap" /><TextBlock Text="{Binding Diagnostics.OsVersion}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8">
                            <StackPanel><TextBlock Text="Tempo ligado" /><TextBlock FontWeight="SemiBold" Text="{Binding Diagnostics.UptimeText}" /></StackPanel>
                        </Border>
                        <Border Padding="14" Background="{StaticResource HubWarningSurface}" CornerRadius="8">
                            <StackPanel><TextBlock Text="Reparos" /><StackPanel Orientation="Horizontal"><Button Margin="0,6,6,0" Command="{Binding Diagnostics.RepairSfcCommand}" Content="SFC" /><Button Margin="0,6,0,0" Command="{Binding Diagnostics.RepairDismCommand}" Content="DISM" /></StackPanel></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <GroupBox Margin="0,0,8,0" Header="Discos">
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Diagnostics.Disks}">
                                <DataGrid.Columns><DataGridTextColumn Binding="{Binding Model, Mode=OneWay}" Header="Modelo" Width="2*" /><DataGridTextColumn Binding="{Binding Status, Mode=OneWay}" Header="Status" Width="*" /><DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay}" Header="Tamanho" Width="*" /></DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Margin="8,0,0,0" Header="Recomendações">
                            <ItemsControl Margin="12" ItemsSource="{Binding Diagnostics.Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="{Binding StringFormat=•  {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </GroupBox>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Diagnostics.StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </TabItem>

            <TabItem Header="Segurança" Uid="security" Tag="&#xE72E;">
                <ScrollViewer Margin="24,8,8,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Width="120" HorizontalAlignment="Right" Command="{Binding Security.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" />
                            <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Segurança do Windows" /><TextBlock Foreground="{StaticResource HubMuted}" Text="Estado local; o TechHub não envia telemetria." /></StackPanel>
                        </DockPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Margin="0,0,10,10" Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8"><StackPanel><TextBlock Text="Defender" /><TextBlock FontSize="16" Text="{Binding Security.DefenderEnabled, Converter={StaticResource SecurityStatus}}" /><TextBlock Text="Proteção em tempo real" /><TextBlock Text="{Binding Security.RealTimeProtectionEnabled, Converter={StaticResource SecurityStatus}}" /></StackPanel></Border>
                            <Border Margin="0,0,10,10" Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8"><StackPanel><TextBlock Text="Firewall" /><TextBlock FontSize="16" Text="{Binding Security.FirewallEnabled, Converter={StaticResource SecurityStatus}}" /><TextBlock Text="BitLocker" /><TextBlock Text="{Binding Security.BitLockerEnabled, Converter={StaticResource SecurityStatus}}" /></StackPanel></Border>
                            <Border Padding="14" Background="{StaticResource HubSurface}" CornerRadius="8"><StackPanel><TextBlock Text="Dispositivo" /><TextBlock Text="TPM" /><TextBlock Text="{Binding Security.TpmPresent, Converter={StaticResource SecurityStatus}}" /><TextBlock Text="Secure Boot" /><TextBlock Text="{Binding Security.SecureBootEnabled, Converter={StaticResource SecurityStatus}}" /></StackPanel></Border>
                        </UniformGrid>
                        <Button Width="210" HorizontalAlignment="Left" Command="{Binding Security.QuickScanCommand}" Content="Solicitar varredura rápida" />
                        <GroupBox Margin="0,16,0,0" Header="Alertas">
                            <ItemsControl Margin="12" ItemsSource="{Binding Security.Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="{Binding StringFormat=•  {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </GroupBox>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal"><TextBlock Foreground="{StaticResource HubMuted}" Text="Administradores locais detectados: " /><TextBlock Foreground="{StaticResource HubMuted}" Text="{Binding Security.LocalAdministratorCount}" /></StackPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Security.StatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Drivers" Uid="drivers" Tag="&#xE964;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Command="{Binding Drivers.RefreshCommand}" Content="Inventariar" Margin="0,4,8,4" />
                                <Button Command="{Binding Drivers.CancelRefreshCommand}" Content="Cancelar consulta" IsEnabled="{Binding Drivers.IsRefreshing, Mode=OneWay}" Style="{StaticResource HubSecondaryButton}" />
                            </WrapPanel>
                            <ProgressBar AutomationProperties.Name="Operação em andamento">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource HubBusyProgress}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drivers.IsBusy, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Drivers.IsRefreshing, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Drivers e dispositivos" TextWrapping="Wrap" /><TextBlock Foreground="{StaticResource HubMuted}" Text="Inventário local; instalação somente de pacote INF local assinado." TextWrapping="Wrap" /></StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Drivers.Drivers}">
                        <DataGrid.Columns><DataGridTextColumn Binding="{Binding DeviceName, Mode=OneWay}" Header="Dispositivo" Width="2*" /><DataGridTextColumn Binding="{Binding Manufacturer, Mode=OneWay}" Header="Fabricante" Width="1.3*" /><DataGridTextColumn Binding="{Binding Provider, Mode=OneWay}" Header="Fornecedor" Width="1.3*" /><DataGridTextColumn Binding="{Binding Version, Mode=OneWay}" Header="Versão" Width="*" /><DataGridCheckBoxColumn Binding="{Binding HasProblem, Mode=OneWay}" ElementStyle="{StaticResource HubReadOnlyCheckBox}" Header="Problema" Width="Auto" /></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="{StaticResource HubSurface}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Instalar pacote local assinado (INF)" />
                            <DockPanel><Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding Drivers.InstallOfflineCommand}" Content="Verificar e instalar" /><TextBox Text="{Binding Drivers.InfPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caminho do arquivo INF assinado" /></DockPanel>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="INF publicado (oem#.inf)" /><TextBox Text="{Binding Drivers.BackupInfName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="INF publicado para backup" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Pasta vazia de destino" /><TextBox Text="{Binding Drivers.BackupDestination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasta de backup de drivers" /></StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Margin="8,0,0,0" Command="{Binding Drivers.BackupCommand}" Content="Fazer backup" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Drivers.StatusMessage}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Limpeza" Uid="cleaning" Tag="&#xEA99;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="120" HorizontalAlignment="Right" Command="{Binding Cleaning.AnalyzeCommand}" Content="Gerar prévia" DockPanel.Dock="Right" />
                        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Limpeza controlada" /><TextBlock Foreground="{StaticResource HubMuted}" Text="A análise não apaga arquivos; a execução exige confirmação e ponto de restauração." /></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Modo:" /><ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="120" ItemsSource="{Binding Cleaning.Modes}" SelectedItem="{Binding Cleaning.Mode}" /><Button Grid.Column="2" Command="{Binding Cleaning.ExecuteCommand}" Content="Executar prévia" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><GroupBox Margin="0,0,10,0" Header="Escopos"><ItemsControl Margin="10" ItemsSource="{Binding Cleaning.Scopes}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,0,0,7" Content="{Binding Label}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox><DataGrid Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Cleaning.Items}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Location, Mode=OneWay}" Header="Arquivo" Width="2*" /><DataGridTextColumn Binding="{Binding Bytes, Mode=OneWay}" Header="Bytes" Width="*" /><DataGridTextColumn Binding="{Binding Reason, Mode=OneWay}" Header="Motivo" Width="1.5*" /></DataGrid.Columns></DataGrid></Grid>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Cleaning.StatusMessage}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Clientes e equipamentos" Uid="clients" Tag="&#xE716;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
            <TabItem Header="Atendimento" Uid="tickets" Tag="&#xE8F2;">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="135" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Command="{Binding Tickets.RefreshCommand}" Content="Atualizar" /><StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="Central de atendimento" /><TextBlock Foreground="{StaticResource HubMuted}" Text="Chamados locais, comentários e diagnóstico anexável." /></StackPanel></DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Título" /><TextBox Text="{Binding Tickets.Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Título do chamado" MaxLength="200" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Descrição" /><TextBox Text="{Binding Tickets.Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição do chamado" MaxLength="4000" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Categoria" /><ComboBox ItemsSource="{Binding Tickets.Categories}" SelectedItem="{Binding Tickets.Category}" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Prioridade" /><ComboBox ItemsSource="{Binding Tickets.Priorities}" SelectedItem="{Binding Tickets.Priority}" /></StackPanel>
                        <Button Grid.Column="4" VerticalAlignment="Bottom" Margin="0" Command="{Binding Tickets.CreateCommand}" Content="Criar" />
                    </Grid>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Tickets.Tickets}" SelectedItem="{Binding Tickets.SelectedTicket}">
                        <DataGrid.Columns><DataGridTextColumn Binding="{Binding Id, Mode=OneWay}" Header="#" Width="50" /><DataGridTextColumn Binding="{Binding Title, Mode=OneWay}" Header="Título" Width="2*" /><DataGridTextColumn Binding="{Binding Category, Mode=OneWay}" Header="Categoria" Width="*" /><DataGridTextColumn Binding="{Binding Priority, Mode=OneWay}" Header="Prioridade" Width="*" /><DataGridTextColumn Binding="{Binding Status, Mode=OneWay}" Header="Status" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"><StackPanel><TextBlock Text="DESCRIÇÃO" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding Tickets.SelectedTicket.Description, TargetNullValue=Selecione um chamado}" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
                        <GroupBox Grid.Column="1" Header="Comentários"><ListBox ItemsSource="{Binding Tickets.Comments}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontSize="11" Foreground="{StaticResource HubMuted}"><Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:dd/MM HH:mm}}" /></TextBlock><TextBlock Text="{Binding Body}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
                    </Grid>
                    <DockPanel Grid.Row="4" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding Tickets.SetResolvedCommand}" Content="Resolver" /><Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding Tickets.CollectDiagnosticsCommand}" Content="Coletar diagnóstico" /><Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding Tickets.AddCommentCommand}" Content="Comentar" /><TextBox Text="{Binding Tickets.Comment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Novo comentário" ToolTip="Escreva um comentário para o chamado selecionado" /></DockPanel>
                    <TextBlock Grid.Row="5" Margin="0,10,0,0" Text="{Binding Tickets.StatusMessage}" Foreground="{StaticResource HubMuted}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Histórico de execução" Uid="history" Tag="&#xE81C;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
            <TabItem Header="Relatórios" Uid="reports" Tag="&#xE9F9;">
                <StackPanel Margin="24,8,8,8">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Relatórios e exportação" />
                    <TextBlock Margin="0,0,0,16" Foreground="{StaticResource HubMuted}" Text="Exportação local dos chamados em formatos abertos." />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Reports.CsvPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding Reports.ExportCsvCommand}" Content="Exportar CSV" /></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Reports.JsonPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding Reports.ExportJsonCommand}" Content="Exportar JSON" /></Grid>
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource HubMuted}" Text="{Binding Reports.StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Software" Uid="software" Tag="&#xE71D;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock FontSize="22" FontWeight="SemiBold" Text="Software e atualizações" /><TextBlock Foreground="{StaticResource HubMuted}" Text="Inventário do registro e atualizações via winget, sempre com confirmação." TextWrapping="Wrap" /><WrapPanel><Button Margin="0,8,8,0" Command="{Binding Software.RefreshCommand}" Content="Inventário" /><Button Margin="0,8,8,0" Command="{Binding Software.CheckUpgradesCommand}" Content="Verificar atualizações" /><Button Margin="0,8,0,0" Command="{Binding Software.UpgradeAllCommand}" Content="Atualizar tudo" /></WrapPanel></StackPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Software.Software}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="Nome" Width="2*" /><DataGridTextColumn Binding="{Binding Version, Mode=OneWay}" Header="Versão" Width="*" /><DataGridTextColumn Binding="{Binding Publisher, Mode=OneWay}" Header="Fabricante" Width="1.5*" /><DataGridTextColumn Binding="{Binding Source, Mode=OneWay}" Header="Origem" Width="1.5*" /></DataGrid.Columns></DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,12,0,4" Foreground="{StaticResource HubMuted}" Text="{Binding Software.UpgradeMessage}" TextWrapping="Wrap" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Software.UpgradeLines}" />
                </Grid>
            </TabItem>

            <TabItem Header="Automação" Uid="automation" Tag="&#xE945;">
                <Grid Margin="24,8,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><Button Width="120" HorizontalAlignment="Right" Command="{Binding Automation.RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" /><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Automação" /><TextBlock Foreground="{StaticResource HubMuted}" Text="Playbooks locais com ações aprovadas e confirmação." /></StackPanel></DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Automation.Playbooks}" SelectedItem="{Binding Automation.SelectedPlaybook}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Foreground="{StaticResource HubMuted}" Text="{Binding Description}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal"><TextBlock Text="Etapas: " /><TextBlock Text="{Binding Steps.Count}" /></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Width="140" HorizontalAlignment="Left" Command="{Binding Automation.RunCommand}" Content="Executar playbook" DockPanel.Dock="Left" /><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource HubMuted}" Text="{Binding Automation.StatusMessage}" TextWrapping="Wrap" /></DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Assistente" Uid="assistant" Tag="&#xE8F2;">
                <ScrollViewer Margin="24,8,8,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Assistente de diagnóstico" />
                        <TextBlock Margin="0,0,0,12" Foreground="{StaticResource HubMuted}" Text="Funciona offline por regras; não envia sintomas para serviços externos." TextWrapping="Wrap" />
                        <TextBlock Text="Descreva o sintoma (por exemplo, sem internet)" />
                        <DockPanel Margin="0,0,0,16"><Button Width="100" Margin="8,0,0,0" Command="{Binding Assistant.AskCommand}" Content="Analisar" DockPanel.Dock="Right" /><TextBox Text="{Binding Assistant.Symptom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sintoma para análise offline" /></DockPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Assistant.Summary}" TextWrapping="Wrap" />
                        <GroupBox Margin="0,16,0,0" Header="Perguntas"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.Questions}" /></GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="Verificações recomendadas"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.RecommendedChecks}" /></GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="Ações seguras"><ItemsControl Margin="12" ItemsSource="{Binding Assistant.SafeActions}" /></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Backup e restauração" Uid="backup" Tag="&#xE8B7;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
            <TabItem Header="Configurações" Uid="settings" Tag="&#xE115;"><views:WorkspaceView DataContext="{Binding Workspace}" /></TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{StaticResource HubSidebar}" Padding="18,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Margin="16,3,0,3" Foreground="{StaticResource HubMuted}" FontSize="11" Text="{Binding ApplicationVersionLabel, Mode=OneWay}" /><TextBlock FontSize="11" Text="{Binding LoadStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LoadStatus}" /></Grid></Border>
    </Grid>
</ui:FluentWindow>
