<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic dark palette; controls and views share the same state colors. -->
    <SolidColorBrush x:Key="HubBackground" Color="#0F172A" />
    <SolidColorBrush x:Key="HubSidebar" Color="#122439" />
    <SolidColorBrush x:Key="HubPanel" Color="#142236" />
    <SolidColorBrush x:Key="HubSurface" Color="#17263A" />
    <SolidColorBrush x:Key="HubAlternateSurface" Color="#1D3048" />
    <SolidColorBrush x:Key="HubHeaderSurface" Color="#203650" />
    <SolidColorBrush x:Key="HubInfoSurface" Color="#172E4D" />
    <SolidColorBrush x:Key="HubSecondarySurface" Color="#292345" />
    <SolidColorBrush x:Key="HubSuccessSurface" Color="#12372F" />
    <SolidColorBrush x:Key="HubWarningSurface" Color="#3A2B19" />
    <SolidColorBrush x:Key="HubMapSurface" Color="#0F1B2D" />
    <SolidColorBrush x:Key="HubBorder" Color="#526A85" />
    <SolidColorBrush x:Key="HubInk" Color="#E6EDF5" />
    <SolidColorBrush x:Key="HubMuted" Color="#A7B6C8" />
    <SolidColorBrush x:Key="HubAccent" Color="#1768C4" />
    <SolidColorBrush x:Key="HubOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HubHover" Color="#284265" />
    <SolidColorBrush x:Key="HubSelection" Color="#1768C4" />
    <SolidColorBrush x:Key="HubPressed" Color="#104E94" />
    <SolidColorBrush x:Key="HubFocus" Color="#61D5D1" />
    <SolidColorBrush x:Key="HubBrand" Color="#59D3CF" />
    <SolidColorBrush x:Key="HubSuccess" Color="#8EE1CA" />
    <SolidColorBrush x:Key="HubInfo" Color="#60A5FA" />
    <SolidColorBrush x:Key="HubError" Color="#E57373" />
    <SolidColorBrush x:Key="HubDisabledSurface" Color="#223044" />
    <SolidColorBrush x:Key="HubDisabledInk" Color="#A7B6C8" />
    <!-- Native WPF templates share these brushes in the app and isolated rendering. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{Binding Color, Source={StaticResource HubSurface}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{Binding Color, Source={StaticResource HubInk}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{Binding Color, Source={StaticResource HubSurface}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{Binding Color, Source={StaticResource HubInk}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{Binding Color, Source={StaticResource HubDisabledInk}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Color, Source={StaticResource HubSelection}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Color, Source={StaticResource HubOnAccent}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Color, Source={StaticResource HubHover}}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Color, Source={StaticResource HubInk}}" />
    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="HubButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HubOnAccent}" />
        <Setter Property="Background" Value="{StaticResource HubAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource HubAccent}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HubPressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource HubFocus}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HubDisabledSurface}" /><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource HubButton}" />
    <Style x:Key="HubSecondaryButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
        <Setter Property="Background" Value="{StaticResource HubSurface}" />
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubBorder}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource HubSurface}" />
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource HubInk}" />
        <Setter Property="SelectionBrush" Value="{StaticResource HubSelection}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource HubFocus}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource HubDisabledSurface}" /><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HubComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource HubSurface}" />
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubBorder}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="10,5,30,5" IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                            <Border Background="{StaticResource HubSurface}" BorderBrush="{StaticResource HubBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource HubFocus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource HubDisabledSurface}" /><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource HubComboBox}" />
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource HubSurface}" />
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource HubSelection}" /><Setter Property="Foreground" Value="{StaticResource HubOnAccent}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource HubSurface}" />
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="RowBackground" Value="{StaticResource HubSurface}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource HubAlternateSurface}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HubHeaderSurface}" /><Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="Padding" Value="10,6" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource HubSelection}" /><Setter Property="Foreground" Value="{StaticResource HubOnAccent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,5" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource HubSelection}" /><Setter Property="Foreground" Value="{StaticResource HubOnAccent}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource HubFocus}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource HubSurface}" /><Setter Property="Foreground" Value="{StaticResource HubInk}" /><Setter Property="BorderBrush" Value="{StaticResource HubBorder}" />
    </Style>
    <Style x:Key="HubListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource HubSelection}" /><Setter Property="Foreground" Value="{StaticResource HubOnAccent}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource HubFocus}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource HubListBoxItem}" />
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border x:Name="CheckSurface" Width="16" Height="16" VerticalAlignment="Center" Background="{StaticResource HubSurface}" BorderBrush="{StaticResource HubBorder}" BorderThickness="1" CornerRadius="2">
                    <TextBlock x:Name="CheckMark" Text="✓" Foreground="{StaticResource HubInk}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckMark" Property="Text" Value="−" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource HubFocus}" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource HubDisabledSurface}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HubBusyProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" /><Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="IsIndeterminate" Value="True" /><Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Background" Value="{StaticResource HubSurface}" /><Setter Property="Foreground" Value="{StaticResource HubInfo}" />
    </Style>
    <Style x:Key="HubReadOnlyCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="12" /><Setter Property="BorderBrush" Value="{StaticResource HubBorder}" /><Setter Property="Background" Value="{StaticResource HubSurface}" /><Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="{StaticResource HubHeaderSurface}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="5,5,0,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource HubDisabledInk}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HubNavigationItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource HubInk}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavSurface" Background="Transparent" CornerRadius="7" Padding="12,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HubHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HubSelection}" /><Setter Property="Foreground" Value="{StaticResource HubOnAccent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource HubFocus}" /><Setter TargetName="NavSurface" Property="BorderThickness" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HubNavigation" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource HubNavigationItem}" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{StaticResource HubBackground}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource HubSidebar}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="*" /><RowDefinition Height="65" /></Grid.RowDefinitions>
                                <StackPanel Margin="24,17,20,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontSize="27" FontWeight="Bold" Foreground="{StaticResource HubOnAccent}" Text="tech" /><TextBlock FontSize="27" FontWeight="Bold" Foreground="{StaticResource HubBrand}" Text="hub" /><TextBlock Margin="9,10,0,0" Foreground="{StaticResource HubMuted}" FontSize="11" MaxWidth="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding ApplicationVersion, Mode=OneWay}" Text="{Binding ApplicationVersion, Mode=OneWay}" /></StackPanel>
                                    <TextBlock Foreground="{StaticResource HubMuted}" FontSize="11" Text="CENTRAL DE SUPORTE DE TI" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                                <Border Grid.Row="2" BorderBrush="{StaticResource HubBorder}" BorderThickness="0,1,0,0" Margin="20,4,20,0" Padding="0,12,0,0"><StackPanel><TextBlock Foreground="{StaticResource HubSuccess}" FontSize="12" Text="●  Local por padrão" /><TextBlock Foreground="{StaticResource HubMuted}" FontSize="11" Text="Seus dados neste computador" /></StackPanel></Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="20,16,20,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel Margin="4,0,4,14"><TextBlock DockPanel.Dock="Right" Text="WINDOWS · WORKSPACE" FontSize="10" Foreground="{StaticResource HubMuted}" VerticalAlignment="Center" /><TextBlock Text="OPERAÇÃO / CENTRAL TÉCNICA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HubMuted}" /></DockPanel>
                            <Border Grid.Row="1" Background="{StaticResource HubPanel}" BorderBrush="{StaticResource HubBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
